# TLS for the Opaya web app. Caddy gets and renews the certificate itself.
{$OPAYA_DOMAIN:app.opaya.dev} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The web server has its own limits (web/src/server.ts). This one stops a large body before it reaches the server.
	# The web app's WebSocket is not a request body.
	@body not path /app/ws
	request_body @body {
		max_size 20MB
	}
	reverse_proxy web:3000
}
