{
  "name": "opaya-web",
  "version": "0.1.0",
  "private": true,
  "description": "Opaya accounts, plans and the web app (app.opaya.dev).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate-cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "dev:memory": "tsx scripts/dev-server.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/stripe": "1.7.7",
    "@hono/node-server": "2.1.3",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "google-auth-library": "11.1.0",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "stripe": "22.6.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "kysely-pglite-dialect": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
